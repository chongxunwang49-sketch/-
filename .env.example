# ============================================================
# 环境配置模板: 复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================

# --- LLM 配置(模型可插拔: ollama=本地模型 / deepseek=官方API)---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# 切换 DeepSeek 官方 API 时填写(LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 切换 dify 智能体应用时填写(LLM_PROVIDER=dify,4 个角色各一组,见 dify的详细操作.md)
DIFY_BASE_URL=http://localhost/v1
DIFY_SENTIMENT_APP_ID=
DIFY_SENTIMENT_API_KEY=
DIFY_TECHNICAL_APP_ID=
DIFY_TECHNICAL_API_KEY=
DIFY_RISK_APP_ID=
DIFY_RISK_API_KEY=
DIFY_REPORT_APP_ID=
DIFY_REPORT_API_KEY=
# LLM 单次调用超时(秒)
LLM_TIMEOUT=180

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock_agent

# --- ChromaDB: local=本地持久化目录 / server=独立服务(HTTP) ---
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=chroma_db

# --- Embedding: ollama=本地 bge 平替(默认,零下载) / st=本地 BGE-M3(需先下载模型) ---
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=quentinz/bge-large-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-m3
# 国内下载模型走镜像(仅 st 提供方需要)
HF_ENDPOINT=https://hf-mirror.com
